# PostgreSQL (shared server, multiple logical DBs)
DB_HOST=localhost
DB_USER=zola
DB_PASSWORD=zola_pass
AUTH_DB_NAME=zola_identity_db
USER_DB_NAME=zola_user_db
CALL_DB_NAME=zola_call_db
FILE_DB_NAME=zola_file_db
AI_META_DB_NAME=zola_ai_meta_db
NOTIFICATION_DB_NAME=zola_notification_db
ADMIN_DB_NAME=zola_admin_db

# MongoDB
CHAT_MONGO_URI=mongodb://localhost:27017/zola_chat_db
AI_MONGO_URI=mongodb://localhost:27017/zola_ai_db

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET=replace_with_very_long_secret

# AWS
AWS_ACCESS_KEY=replace_me
AWS_SECRET_KEY=replace_me
S3_BUCKET=zola-shared-files-dev
AWS_REGION=ap-southeast-1

# OpenAI
OPENAI_API_KEY=replace_me

# TURN
TURN_SECRET=replace_me

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@zola.app
SMTP_PASSWORD=replace_me

# Frontend
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8083/ws
VITE_TURN_HOST=turn.zola.app
